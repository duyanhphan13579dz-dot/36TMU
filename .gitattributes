# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.html text
*.css text
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.md text

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.wav binary
*.mp3 binary
